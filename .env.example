# Salin ke .env, atau jalankan: uv run csmt wizard
# Panduan lengkap autentikasi: docs/AUTH.md

CREATIO_BASE_URL=https://your-creatio.example
# /odata untuk Creatio .NET 8 (default); /0/odata untuk .NET Framework klasik
CREATIO_ODATA_PATH=/odata

# Direkomendasikan: oauth2 (client credentials). Lihat docs/AUTH.md.
# forms = username/password dengan cookie AuthService.svc
# basic = HTTP Basic (hanya bila UseCsrfToken=false di server)
CREATIO_AUTH_MODE=oauth2
CREATIO_CLIENT_ID=your-client-id
CREATIO_CLIENT_SECRET=your-client-secret
# Nilai system setting OAuth20IdentityServerUrl. Default site cloud: https://<subdomain>_is.creatio.com
# Token endpoint = {ini}/connect/token
CREATIO_IDENTITY_URL=https://your-subdomain_is.creatio.com

# Untuk forms/basic, pakai user integrasi (BUKAN Supervisor):
# CREATIO_AUTH_MODE=forms
# CREATIO_USERNAME=integration.user
# CREATIO_PASSWORD=change-me

CREATIO_ENTITY=Contact
CREATIO_VERIFY_SSL=true
CREATIO_TIMEOUT=60
CREATIO_MAX_RETRIES=5
CREATIO_RETRY_BACKOFF=1
CREATIO_RETRY_MAX_DELAY=30
